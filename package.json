{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && vite build",
    "build:client": "vite build --config vite.client.config.ts",
    "test": "npm run test:server && npm run test:dom",
    "test:server": "vitest run",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "verify": "npm run build && npm test && tsc --noEmit && git diff --check && git diff --exit-code -- public/static/bundle.js",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.12.26",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "@types/node": "^22.20.1",
    "happy-dom": "^15.11.7",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.4.0"
  }
}
